pipeline {
    agent any

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Build started'
            }
        }

        stage('Test') {
            steps {
                sh 'test -f index.html'
                echo 'Test successful'
            }
        }

        stage('Deploy') {
            steps {
                sshagent(credentials: ['ec2-deploy-key']) {
                    sh '''
                        scp -o StrictHostKeyChecking=yes \
                        index.html deploy@172.31.44.203:/tmp/index.html

                        ssh -o StrictHostKeyChecking=yes \
                        deploy@172.31.44.203 \
                        'sudo install -m 644 /tmp/index.html /var/www/html/index.html'
                    '''
                }
            }
        }
    }
}
